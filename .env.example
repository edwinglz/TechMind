# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API key. Only needed when AI_MODE=live.
ANTHROPIC_API_KEY=your-api-key-here

# mock = canned fixture briefs from /fixtures (free, use for development)
# live = real Claude calls (costs money, use for prompt testing and the demo)
AI_MODE=mock

# SQLite database location. The demo company is seeded automatically if the database is empty.
DATABASE_URL=sqlite:///./data/techmind.db

# Folder for uploaded ticket photos and import files.
UPLOAD_DIR=uploads

# Optional. "Today" for trend math (rising/fading, repeat failures), as YYYY-MM-DD.
# Leave blank to use the real date. Set it if the demo runs long after the demo data ends.
AS_OF_DATE=
