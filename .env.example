# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API key. Only needed when AI_MODE=live.
ANTHROPIC_API_KEY=your-api-key-here

# mock = briefs built from the company's own data with simple rules (free, no key needed)
# live = real Claude calls (costs money, use for prompt testing and the demo)
AI_MODE=mock

# SQLite database location. The demo company is seeded automatically if the database is empty.
DATABASE_URL=sqlite:///./data/techmind.db

# Folder for uploaded ticket photos and import files.
UPLOAD_DIR=uploads

# Optional. "Today" for trend math (rising/fading, repeat failures), as YYYY-MM-DD.
# Leave blank to use the real date. Set it if the demo runs long after the demo data ends.
AS_OF_DATE=

# Signs the login cookie so it can't be forged. Use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
# If blank, a random key is generated at startup (everyone is logged out on restart).
SECRET_KEY=

# Password for the demo accounts (manager, ana, luis), applied when the demo company is
# first seeded. If blank, a random password is generated and printed in the startup log.
DEMO_PASSWORD=

# Optional. Most live (Claude) briefs allowed per hour across everyone; beyond it, mock briefs are used.
LIVE_BRIEFS_PER_HOUR=40

# Optional. Seconds a mock brief waits so the "Preparing the brief" steps are visible.
MOCK_DELAY_SECONDS=1.6
